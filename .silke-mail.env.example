# .silke-mail.env — SMTP credentials for the silke-lengler.ch contact form.
# Copy to `.silke-mail.env` (gitignored) and fill with a real silke-lengler.ch
# mailbox. Read by app/api/silke-contact/route.ts. Mirrors .barbazza-mail.env.
# NEVER commit the real file.

SMTP_HOST=mail.silke-lengler.ch
SMTP_USER=silke@silke-lengler.ch
SMTP_PASS=

# Send-as address (defaults to SMTP_USER):
MAIL_FROM=silke@silke-lengler.ch

# Optional archive copy of every submission:
# MAIL_ARCHIVE_BCC=praxis@silke-lengler.ch

# Submission ports to try in order — "port:secure" (465 implicit TLS, 587/26 STARTTLS):
SMTP_PORTS=465:true,587:false,26:false

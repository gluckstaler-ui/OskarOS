# public/ holds session folders, generated bundles and binaries (all ignored),
# but the hand-written top-level source files ARE tracked. A whole-dir `public/`
# ignore can't be un-ignored file-by-file, so ignore the CONTENTS (`public/*`)
# and re-include the source explicitly. Session subdirs stay ignored (git won't
# descend once `public/<dir>` matches). Generated (admin-topbar.js[.map],
# pdf.worker) + junk stay out by omission; Order66.mp3 (audio asset) is tracked.
public/*
!public/admin.html
!public/crm.html
!public/_shell.css
!public/_shell.js
!public/compaction-overlay.html
!public/rejuvenation-overlay.html
!public/CRM-Email-Prototype.html
!public/CRM-Email-Wireframes.html
!public/debug.html
!public/lumberjack-watch.html
!public/Order66.mp3

# Build artifacts
*.tsbuildinfo

# Misc
debug-webdev.sh
lazyblocks-migration/

# Vendored third-party skill — clone from upstream as needed:
# git clone https://github.com/referodesign/refero_skill skills/refero_skill
skills/refero_skill/

# MCP proxy sidecar state — written by /api/active-session, read by
# scripts/mcp-stdio-proxy.mjs. Local-only, regenerated on every session
# switch. Should never be committed.
.runtime/

# WP-CRM-F20 (2026-05-25): runtime CRM data lives here.
#   db/crm.db                — local SQLite projection (F22)
#   db/events/               — append-only event log (F22)
#   db/whatsapp/             — WhatsApp protocol state (auth creds,
#                              envelope store, unmatched.jsonl). Per-laptop-
#                              private, never synced.
# Never committed. Each machine has its own.
db/

# WP-CRM-F20 (2026-05-25): content-addressed media files
# (media/<sha256>.<ext>). WhatsApp downloads + any future attached files.
# Served via auth-gated /api/admin/media/[hash] route, NOT statically.
media/

# Heavy asset / scratch dirs — kept on disk, NOT in git (Ralph 2026-06-03).
# 4.3 GB of binaries; add via git-lfs if they ever need versioning.
Winery/
Fonts/

# Runtime / test artifacts — regenerated, never committed.
logs/
test-results/
__pycache__/
.barbazza-mail.env
.silke-mail.env

# Barbazza Facebook widget token
.barbazza-fb.env

# Scratch / build dirs the deploy excludes (scripts/deploy-server.sh) + the
# per-session MCP config cache (regenerated on every session switch) — not source.
118bbuilder/
CRMxterritoryxfathom/
.cache/
